msgid "NPS Client"
msgstr "NPS 内网穿透客户端"

msgid "NPS is a fast reverse proxy to help you expose a local server behind a NAT or firewall to the internet."
msgstr "NPS 是一种快速反向代理,可帮助您将 NAT 或防火墙后的本地服务器公开到 Internet"

msgid "(host:port) e.g. xxx.com:8024,yyy.com:8025..."
msgstr "(host:port) 例如: xxx.com:8024,yyy.com:8025..."

msgid "(vkey) e.g. vkey1,vkey2..."
msgstr "(vkey) 例如: vkey1,vkey2..."

msgid "(tls|quic|wss|tcp) e.g. tls,quic..."
msgstr "(tls|quic|wss|tcp) 例如: tls,quic..."

msgid "e.g. 8.8.8.8"
msgstr "例如: 8.8.8.8"

msgid "NOT INSTALLED"
msgstr "未安装"

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "Basic Setting"
msgstr "基本设置"

msgid "Protocol Type"
msgstr "协议类型"

msgid "Server Address"
msgstr "服务端地址"

msgid "vkey"
msgstr "唯一验证密钥"

msgid "DNS Server"
msgstr "DNS 服务器"

msgid "Extra Arguments"
msgstr "额外参数"

msgid "Update NPC"
msgstr "更新 NPC"

msgid "Click to update to the latest version"
msgstr "点击即可更新到最新版本"

msgid "Install NPC"
msgstr "安装 NPC"

msgid "Click to install or update NPC via script"
msgstr "点击通过脚本安装或更新 NPC"

msgid "Basic Settings"
msgstr "基本设置"

msgid "Advanced Settings"
msgstr "高级设置"

msgid "Legacy Connection"
msgstr "旧版连接方式"

msgid "Config File"
msgstr "配置文件"

msgid "Log Level"
msgstr "日志级别"

msgid "Global Settings"
msgstr "全局设置"

msgid "Off"
msgstr "关闭"

msgid "Logs go to the system log (Status > System Log) when a level is chosen."
msgstr "选择级别后，日志写入系统日志（状态 > 系统日志）。"

msgid "Additional NPC arguments in shell syntax, line breaks allowed; quote values containing & ? | ; e.g. -pipes=multi -log=stdout"
msgstr "其他 NPC 参数，按 shell 语法解析，可换行；值中含 & ? | ; 时请加引号，例如: -pipes=multi -log=stdout"

msgid "Optional INI config file path (-config). Ignored by NPC when connections are given."
msgstr "可选，INI 配置文件路径 (-config)。填写了连接时 NPC 会忽略它。"

msgid "Deprecated in NPC 0.35 (-server/-vkey/-type). Used only when no connection or config file is set, because NPC refuses -server/-vkey together with -launch."
msgstr "NPC 0.35 起已弃用 (-server/-vkey/-type)。仅在没有启用的连接和配置文件时使用，因为 NPC 不允许 -server/-vkey 与 -launch 同时出现。"

msgid "Connections"
msgstr "连接"

msgid "Each connection runs independently inside the same NPC process. The name is used as the connection name (#name) in logs and by via= of local access. Copy the link from the NPS web page \"Launch command\"; line breaks and spaces in it are removed on save."
msgstr "每条连接在同一个 NPC 进程中独立运行。名称即连接名 (#名称)，用于日志和本地访问的 via=。链接从 NPS 网页“启动命令”复制；保存时会去掉其中的换行和空格。"

msgid "Launch Link"
msgstr "启动链接"

msgid "npc:// link, @/path/to/file, http(s) URL or base64"
msgstr "npc:// 链接、@/文件路径、http(s) 网址或 base64"

msgid "Launch link is empty"
msgstr "启动链接不能为空"

msgid "Local Access"
msgstr "本地访问"

msgid "Optional point-to-point access listeners on this router (-L). e.g. tcp://0.0.0.0:2000?access=KEY&target=192.168.1.10:22&via=home"
msgstr "可选，在本路由器上开放的点对点访问端口 (-L)，例如: tcp://0.0.0.0:2000?access=KEY&target=192.168.1.10:22&via=home"

msgid "Access Link"
msgstr "访问链接"

msgid "exit code"
msgstr "退出码"

msgid "set Log Level to see the reason in System Log"
msgstr "设置日志级别后可在系统日志中查看原因"

msgid "Running command (keys hidden)"
msgstr "当前运行命令（已隐藏密钥）"
